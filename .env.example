# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HTTP-only session cookies (generate a strong 32+ char random string in production).
SESSION_SECRET="change-me-to-a-long-random-secret"

# INITIAL ADMIN / SUPER ADMIN SEEDING (Used only on first database boot when no Super Admin exists)
SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# OPTIONAL PAYMENT GATEWAY (Razorpay - Manual UPI/Cash/Bank recording is used unless configured)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# OPTIONAL EXTERNAL NOTIFICATIONS (Disabled cleanly until configured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
WHATSAPP_API_TOKEN=""

